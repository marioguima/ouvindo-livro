# Comando externo de TTS.
# Deixe vazio para gerar apenas arquivos de narracao em texto.
# Exemplo:
# TTS_COMMAND=python caminho/tts.py --input "{input}" --output "{output}"
TTS_COMMAND=

# Extensao esperada pelo comando de TTS: mp3, wav, m4a etc.
TTS_OUTPUT_EXTENSION=mp3

# Quantidade maxima de caracteres enviada por capitulo ao TTS.
# Se o capitulo passar disso, ele ainda sera salvo inteiro em Markdown,
# mas o texto de narracao sera truncado para evitar geracoes enormes no MVP.
TTS_MAX_CHARS_PER_CHAPTER=18000

# Idioma padrao usado nos metadados.
BOOK_LANGUAGE=pt-BR
